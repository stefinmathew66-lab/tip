---
import Layout from '../layouts/Layout.astro';
---

<Layout 
    title="Tip Pooling Calculator — Free TipSplit App" 
    description="Calculate and pool tips for your restaurant shift easily. Free tip pooling calculator app supporting hours-based, equal, and role points splits with compliance check."
    keywords="tip pooling calculator, tip pooling, tip pooling calculator app, tip pooling calculator free, free tip pooling calculator"
>
    <!-- Skip link for keyboard users -->
    <a href="#step1" class="skip-link absolute left-[-9999px] top-2 z-50 bg-accent text-bg-primary px-4 py-2 rounded-sm text-xs font-semibold no-underline focus:left-4">Skip to calculator</a>

    <main class="app-container relative z-10 max-w-(--max-width) mx-auto px-4 py-6 sm:px-6 sm:py-10 pb-12">
        <!-- Header -->
        <header class="header text-center mb-8">
            <div class="logo flex items-center justify-center gap-2 mb-2">
                <div class="logo-icon text-accent flex drop-shadow-[0_0_8px_var(--color-accent-glow)]" aria-hidden="true">
                    <svg width="28" height="28" viewBox="0 0 28 28" fill="none">
                        <circle cx="14" cy="14" r="13" stroke="currentColor" stroke-width="2"/>
                        <text x="14" y="19" text-anchor="middle" fill="currentColor" font-size="16" font-weight="700">$</text>
                    </svg>
                </div>
                <span class="logo-text text-3xl font-extrabold bg-accent-gradient bg-clip-text text-transparent tracking-tight">TipSplit</span>
            </div>
            <p class="tagline text-text-secondary text-sm font-normal max-w-xl mx-auto">Tired of your servers thinking you're doing the tip math wrong? I built a free calculator that shows them the exact breakdown.</p>
            <div class="flex items-center justify-center flex-wrap gap-x-3 gap-y-1.5 mt-4 text-[0.78rem] uppercase tracking-wider font-extrabold text-text-primary">
                <span class="text-text-secondary">State Rules:</span>
                <a href="/" class="text-text-primary hover:text-accent transition-colors duration-150 no-underline font-extrabold">FLSA Baseline</a>
                <span class="w-1.5 h-1.5 rounded-full bg-border/60" aria-hidden="true"></span>
                <a href="/california-tip-pooling-calculator" class="text-text-primary hover:text-accent transition-colors duration-150 no-underline font-extrabold">California</a>
                <span class="w-1.5 h-1.5 rounded-full bg-border/60" aria-hidden="true"></span>
                <a href="/texas-tip-pooling-calculator" class="text-text-primary hover:text-accent transition-colors duration-150 no-underline font-extrabold">Texas</a>
                <span class="w-1.5 h-1.5 rounded-full bg-border/60" aria-hidden="true"></span>
                <a href="/new-york-tip-pooling-calculator" class="text-text-primary hover:text-accent transition-colors duration-150 no-underline font-extrabold">New York</a>
                <span class="w-1.5 h-1.5 rounded-full bg-border/60" aria-hidden="true"></span>
                <a href="/florida-tip-pooling-calculator" class="text-text-primary hover:text-accent transition-colors duration-150 no-underline font-extrabold">Florida</a>
            </div>
            <nav class="flex items-center justify-center gap-3.5 mt-3 text-[0.7rem] font-medium text-text-muted">
                <a href="/about" class="text-text-secondary hover:text-accent transition-colors duration-150 no-underline">About Us</a>
                <span class="w-1 h-1 rounded-full bg-border/50" aria-hidden="true"></span>
                <a href="/privacy" class="text-text-secondary hover:text-accent transition-colors duration-150 no-underline">Privacy Policy</a>
                <span class="w-1 h-1 rounded-full bg-border/50" aria-hidden="true"></span>
                <a href="/terms" class="text-text-secondary hover:text-accent transition-colors duration-150 no-underline">Terms & Conditions</a>
                <span class="w-1 h-1 rounded-full bg-border/50" aria-hidden="true"></span>
                <a href="/contact" class="text-text-secondary hover:text-accent transition-colors duration-150 no-underline">Contact Us</a>
            </nav>
        </header>
        
        <!-- Privacy & Trust Guarantee Banner -->
        <div class="trust-badge-banner" role="region" aria-label="Privacy & Trust Guarantee">
            <span class="trust-badge-item" title="Calculations run locally in your browser. No data leaves your machine.">
                🔒 <span>100% Local & Private</span>
            </span>
            <span class="w-1.5 h-1.5 rounded-full bg-border/40 max-sm:hidden" aria-hidden="true"></span>
            <span class="trust-badge-item" title="No email, credit card, or registration required to use the calculator.">
                📂 <span>No Sign-Up or Account</span>
            </span>
            <span class="w-1.5 h-1.5 rounded-full bg-border/40 max-sm:hidden" aria-hidden="true"></span>
            <span class="trust-badge-item" title="Calculations are transparently detailed so you can audit them yourself.">
                🧮 <span>Auditable Calculations</span>
            </span>
            <span class="w-1.5 h-1.5 rounded-full bg-border/40 max-sm:hidden" aria-hidden="true"></span>
            <span class="trust-badge-item" title="No Wi-Fi in the back office? Doesn't matter. I coded it to work completely offline so you aren't trapped at work when the internet goes down.">
                🌐 <span>Works 100% Offline</span>
            </span>
        </div>


        <!-- Step 1: Total Tips -->
        <section class="card step-card bg-bg-card border border-border rounded-lg p-6 mb-4 transition-colors duration-200 ease-(--ease-base) hover:border-[rgba(240,165,0,0.25)] hover:shadow-[0_4px_30px_rgba(240,165,0,0.02)]" id="step1" aria-labelledby="step1-heading">
            <div class="step-header flex items-center gap-3 mb-1.5">
                <span class="step-badge flex items-center justify-center w-7 h-7 rounded-full bg-accent-soft text-accent text-xs font-bold shrink-0" aria-hidden="true">1</span>
                <h1 id="step1-heading" class="text-lg font-bold text-text-primary text-balance">Total Tips</h1>
            </div>
            <p class="step-desc text-text-secondary text-xs mb-4 pl-10">Enter the total tip amount to be split among the team.</p>
            <div class="input-group currency-input relative">
                <label for="totalTips" class="sr-only">Total tip amount in dollars</label>
                <span class="currency-symbol absolute left-3.5 top-1/2 -translate-y-1/2 text-text-secondary text-lg font-semibold pointer-events-none z-10" aria-hidden="true">$</span>
                <input type="number" id="totalTips" name="totalTips" placeholder="0.00…" min="0" step="0.01" inputmode="decimal" autocomplete="off" spellcheck="false" class="w-full bg-bg-input border-1.5 border-border rounded-md py-3.5 pl-9 pr-4 text-text-primary text-lg font-medium transition-all duration-200 ease-(--ease-base) placeholder:text-text-muted placeholder:font-normal focus:border-accent focus:shadow-[0_0_0_3px_var(--color-accent-soft)] focus:outline-none [appearance:textfield] [&::-webkit-outer-spin-button]:appearance-none [&::-webkit-inner-spin-button]:appearance-none">
            </div>
        </section>

        <!-- Step 2: Split Method -->
        <section class="card step-card bg-bg-card border border-border rounded-lg p-6 mb-4 transition-colors duration-200 ease-(--ease-base) hover:border-[rgba(240,165,0,0.25)] hover:shadow-[0_4px_30px_rgba(240,165,0,0.02)]" id="step2" aria-labelledby="step2-heading">
            <div class="step-header flex items-center gap-3 mb-1.5">
                <span class="step-badge flex items-center justify-center w-7 h-7 rounded-full bg-accent-soft text-accent text-xs font-bold shrink-0" aria-hidden="true">2</span>
                <h2 id="step2-heading" class="text-lg font-bold text-text-primary text-balance">Split Method</h2>
            </div>
            <p class="step-desc text-text-secondary text-xs mb-4 pl-10">Choose how tips should be divided.</p>
            <div class="method-selector grid grid-cols-3 gap-2.5 max-sm:grid-cols-1 max-sm:gap-2" role="radiogroup" aria-label="Tip split method">
                <button class="method-btn active" data-method="equal" id="methodEqual" role="radio" aria-checked="true">
                    <div class="method-icon text-2xl leading-none" aria-hidden="true">⚖️</div>
                    <div class="method-label text-[0.82rem] font-semibold text-center">Equal Split</div>
                    <div class="method-sub text-[0.7rem] text-text-muted text-center">Same share for everyone</div>
                </button>
                <button class="method-btn" data-method="hours" id="methodHours" role="radio" aria-checked="false" tabindex="-1">
                    <div class="method-icon text-2xl leading-none" aria-hidden="true">⏱️</div>
                    <div class="method-label text-[0.82rem] font-semibold text-center">By Hours</div>
                    <div class="method-sub text-[0.7rem] text-text-muted text-center">Based on time worked</div>
                </button>
                <button class="method-btn" data-method="points" id="methodPoints" role="radio" aria-checked="false" tabindex="-1">
                    <div class="method-icon text-2xl leading-none" aria-hidden="true">⭐</div>
                    <div class="method-label text-[0.82rem] font-semibold text-center">By Role Points</div>
                    <div class="method-sub text-[0.7rem] text-text-muted text-center">Weighted by position</div>
                </button>
            </div>
            
            <div id="pointsSloganNote" class="text-[0.74rem] text-text-secondary mt-3.5 pl-10 flex items-start gap-2 transition-all duration-300" style="display: none;">
                <span class="text-accent text-sm leading-none">💡</span>
                <span>Don't want to split tips evenly with a lazy busser? Use our Points-Based split to make sure your top performers get the highest percentage.</span>
            </div>
        </section>

        <!-- Step 3: Team Members -->
        <section class="card step-card bg-bg-card border border-border rounded-lg p-6 mb-4 transition-colors duration-200 ease-(--ease-base) hover:border-[rgba(240,165,0,0.25)] hover:shadow-[0_4px_30px_rgba(240,165,0,0.02)]" id="step3" aria-labelledby="step3-heading">
            <div class="step-header flex items-center gap-3 mb-1.5">
                <span class="step-badge flex items-center justify-center w-7 h-7 rounded-full bg-accent-soft text-accent text-xs font-bold shrink-0" aria-hidden="true">3</span>
                <h2 id="step3-heading" class="text-lg font-bold text-text-primary text-balance">Team Members</h2>
            </div>
            <p class="step-desc text-text-secondary text-xs mb-4 pl-10">Add everyone who&rsquo;s in the tip pool today.</p>

            <!-- Roster Templates Toolbar -->
            <div class="roster-templates-toolbar mb-4.5 pl-10 flex flex-wrap items-center gap-2">
                <button type="button" id="saveRosterBtn" class="flex items-center gap-1 px-3 py-1.5 bg-bg-input border border-border rounded-sm text-text-secondary text-[0.75rem] font-bold cursor-pointer hover:border-accent hover:text-accent transition-all active:scale-[0.98]">
                    💾 Save Roster Template
                </button>
                <div class="relative inline-block" id="loadRosterContainer">
                    <button type="button" id="loadRosterDropdownBtn" class="flex items-center gap-1.5 px-3 py-1.5 bg-bg-input border border-border rounded-sm text-text-secondary text-[0.75rem] font-bold cursor-pointer hover:border-accent hover:text-accent transition-all active:scale-[0.98]" aria-haspopup="true" aria-expanded="false">
                        📂 Load Roster
                        <svg width="10" height="10" viewBox="0 0 10 10" fill="none" class="transition-transform duration-200" aria-hidden="true">
                            <path d="M2.5 3.75L5 6.25L7.5 3.75" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                    </button>
                    <div id="rosterTemplatesMenu" class="absolute left-0 mt-1.5 w-56 bg-bg-card border border-border rounded-md shadow-lg z-50 py-1 hidden" role="menu">
                        <!-- Dropdown items will be rendered by JS -->
                    </div>
                </div>
            </div>

            <!-- Role presets (only visible in points mode) -->
            <div class="role-presets mb-4 p-3.5 bg-accent-soft rounded-md border border-[rgba(240,165,0,0.1)]" id="rolePresets" style="display:none;">
                <p class="presets-label text-[0.8rem] text-text-secondary mb-2.5 font-medium">Quick add by role:</p>
                <div class="preset-chips flex flex-wrap gap-1.5">
                    <button class="preset-chip" data-role="Server" data-points="10">🍽️ Server (10&nbsp;pts)</button>
                    <button class="preset-chip" data-role="Bartender" data-points="8">🍸 Bartender (8&nbsp;pts)</button>
                    <button class="preset-chip" data-role="Busser" data-points="5">🧹 Busser (5&nbsp;pts)</button>
                    <button class="preset-chip" data-role="Host" data-points="4">👋 Host (4&nbsp;pts)</button>
                    <button class="preset-chip" data-role="Food Runner" data-points="6">🏃 Runner (6&nbsp;pts)</button>
                    <button class="preset-chip" data-role="Barback" data-points="4">🧊 Barback (4&nbsp;pts)</button>
                </div>
            </div>

            <!-- Team list -->
            <div class="team-list flex flex-col gap-2 mb-3" id="teamList" role="list" aria-label="Team members">
                <!-- Team members will be rendered here -->
            </div>

            <button class="add-btn flex items-center justify-center gap-2 w-full p-3 bg-transparent border-1.5 border-dashed border-border rounded-md text-text-secondary text-sm font-medium cursor-pointer transition-all duration-200 ease-(--ease-base) hover:border-accent hover:text-accent hover:bg-accent-soft" id="addMemberBtn">
                <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
                    <path d="M9 3v12M3 9h12" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                </svg>
                Add Team Member
            </button>
        </section>

        <!-- Step 4: Compliance Rules -->
        <section class="card step-card bg-bg-card border border-border rounded-lg p-6 mb-4 transition-colors duration-200 ease-(--ease-base) hover:border-[rgba(240,165,0,0.25)] hover:shadow-[0_4px_30px_rgba(240,165,0,0.02)]" id="stepCompliance" aria-labelledby="compliance-heading">
            <div class="step-header flex items-center gap-3 mb-1.5">
                <span class="step-badge flex items-center justify-center w-7 h-7 rounded-full bg-accent-soft text-accent text-xs font-bold shrink-0" aria-hidden="true">4</span>
                <h2 id="compliance-heading" class="text-lg font-bold text-text-primary text-balance">Compliance Rules</h2>
            </div>
            <p class="step-desc text-text-secondary text-xs mb-4 pl-10">Select state and wage setup to check tip pool compliance.</p>
            
            <div class="compliance-grid grid grid-cols-2 gap-4 max-sm:grid-cols-1 max-sm:gap-3 pl-10">
                <div class="input-group">
                    <label for="stateSelect" class="block text-[0.75rem] font-semibold text-text-secondary uppercase tracking-wider mb-2">Location / State</label>
                    <select id="stateSelect" class="w-full bg-bg-input border-1.5 border-border rounded-md py-3.5 px-3.5 text-text-primary text-sm font-medium transition-all duration-200 ease-(--ease-base) focus:border-accent focus:shadow-[0_0_0_3px_var(--color-accent-soft)] focus:outline-none">
                        <option value="US">Federal (FLSA Baseline)</option>
                        <option value="CA">California</option>
                        <option value="FL">Florida</option>
                        <option value="NY">New York</option>
                        <option value="TX">Texas</option>
                    </select>
                </div>
                
                <div class="input-group flex flex-col justify-end">
                    <label id="tipCreditContainer" class="flex items-center gap-2.5 cursor-pointer py-3 px-1">
                        <input type="checkbox" id="takeTipCredit" class="w-4.5 h-4.5 rounded border-border bg-bg-input text-accent focus:ring-accent-soft focus:ring-offset-bg-primary">
                        <span class="text-sm font-medium text-text-primary">Employer claims a tip credit</span>
                    </label>
                    <div id="tipCreditNote" class="text-[0.72rem] text-text-muted mt-1" style="display:none;"></div>
                </div>
            </div>

            <div class="legal-source-disclaimer mt-4 pt-3.5 border-t border-border/40 text-[0.68rem] text-text-muted leading-relaxed pl-10">
                <span>⚖️ <strong>Legal Disclaimer:</strong> Tip pooling regulations are highly complex and differ by state and local jurisdiction. This tool calculates shares based on user inputs and public rules current as of <strong>August 2026</strong> (source: U.S. Department of Labor). This does not constitute legal advice. Please consult an employment attorney or payroll expert to verify compliance.</span>
            </div>
        </section>

        <!-- Compliance Status Banner -->
        <div id="complianceAlert" class="compliance-alert" style="display:none;">
            <div class="alert-icon text-xl shrink-0"></div>
            <div>
                <h4 class="alert-title"></h4>
                <p class="alert-desc"></p>
            </div>
        </div>

        <!-- Calculate Button -->
        <button class="calculate-btn flex items-center justify-center gap-2.5 w-full py-4 px-6 bg-accent-gradient border-none rounded-lg text-text-on-accent text-[1.05rem] font-bold cursor-pointer mb-4 transition-all duration-250 ease-(--ease-base) shadow-[0_4px_20px_rgba(240,165,0,0.25)] hover:-translate-y-0.5 hover:shadow-[0_6px_28px_rgba(240,165,0,0.35)] active:scale-[0.98] relative overflow-hidden after:absolute after:inset-0 after:bg-gradient-to-br after:from-[rgba(255,255,255,0.1)] after:to-transparent after:pointer-events-none" id="calculateBtn">
            Calculate Tips
            <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                <path d="M4 10h12M12 6l4 4-4 4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
        </button>

        <!-- Results -->
        <section class="card results-card bg-gradient-to-br from-bg-card to-[rgba(52,211,153,0.03)] border-green rounded-lg p-6 mb-4 transition-all duration-200 ease-(--ease-base) hover:border-[rgba(52,211,153,0.2)]" id="resultsCard" style="display:none;" aria-labelledby="results-heading">
            <div class="results-header flex items-center justify-between mb-5 flex-wrap gap-3">
                <h2 id="results-heading" class="text-[1.15rem] font-bold text-text-primary"><span aria-hidden="true">💰</span> Tip Breakdown</h2>
                <div class="results-actions flex gap-2">
                    <button class="action-btn flex items-center gap-1 py-1.5 px-3 bg-bg-input border border-border rounded-sm text-text-secondary text-[0.78rem] font-medium cursor-pointer transition-all duration-150 ease-(--ease-base) hover:border-accent hover:text-accent" id="copyBtn" aria-label="Copy results to clipboard">
                        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                            <rect x="5" y="5" width="9" height="9" rx="1.5" stroke="currentColor" stroke-width="1.5"/>
                            <path d="M11 5V3.5A1.5 1.5 0 009.5 2h-6A1.5 1.5 0 002 3.5v6A1.5 1.5 0 003.5 11H5" stroke="currentColor" stroke-width="1.5"/>
                        </svg>
                        Copy
                    </button>
                    <button class="action-btn flex items-center gap-1 py-1.5 px-3 bg-bg-input border border-border rounded-sm text-text-secondary text-[0.78rem] font-medium cursor-pointer transition-all duration-150 ease-(--ease-base) hover:border-accent hover:text-accent" id="printBtn" aria-label="Print results">
                        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                            <rect x="4" y="10" width="8" height="4" rx="0.5" stroke="currentColor" stroke-width="1.5"/>
                            <rect x="2" y="5" width="12" height="6" rx="1.5" stroke="currentColor" stroke-width="1.5"/>
                            <path d="M4 5V2.5A.5.5 0 014.5 2h7a.5.5 0 01.5.5V5" stroke="currentColor" stroke-width="1.5"/>
                        </svg>
                        Print
                    </button>
                    <button class="action-btn flex items-center gap-1 py-1.5 px-3 bg-bg-input border border-border rounded-sm text-text-secondary text-[0.78rem] font-medium cursor-pointer transition-all duration-150 ease-(--ease-base) hover:border-accent hover:text-accent" id="pdfBtn" aria-label="Download PDF Summary">
                        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                            <path d="M12 10v3a1 1 0 01-1 1H5a1 1 0 01-1-1v-3M8 2v8M5 7l3 3 3-3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                        PDF
                    </button>
                    <button class="action-btn flex items-center gap-1 py-1.5 px-3 bg-bg-input border border-border rounded-sm text-text-secondary text-[0.78rem] font-medium cursor-pointer transition-all duration-150 ease-(--ease-base) hover:border-accent hover:text-accent" id="whatsappBtn" aria-label="Share summary on WhatsApp">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" class="w-3.5 h-3.5">
                            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L0 24l6.335-1.662c1.746.953 3.71 1.458 5.704 1.459h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413"/>
                        </svg>
                        WhatsApp
                    </button>
                </div>
            </div>

            <div class="results-summary grid grid-cols-[repeat(auto-fit,minmax(120px,1fr))] gap-2.5 mb-5" id="resultsSummary">
                <!-- Summary stats -->
            </div>

            <div class="results-table-wrap overflow-x-auto mx-[-8px] px-2">
                <table class="results-table w-full border-collapse" id="resultsTable">
                    <thead>
                        <tr id="resultsTableHead">
                            <!-- Table head rendered by JS -->
                        </tr>
                    </thead>
                    <tbody id="resultsTableBody">
                        <!-- Table body rendered by JS -->
                    </tbody>
                </table>
            </div>

            <div class="results-footer mt-4 pt-4 border-t border-border flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                <button type="button" id="saveShiftBtn" class="flex items-center justify-center gap-1.5 py-2 px-4 bg-accent text-bg-primary rounded-md text-[0.8rem] font-bold cursor-pointer hover:opacity-90 active:scale-[0.98] transition-all self-start shrink-0">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M19 21H5a2 2 0 01-2-2V5a2 2 0 012-2h11l5 5v11a2 2 0 01-2 2z"/>
                        <path d="M17 21v-8H7v8M7 3v5h8"/>
                    </svg>
                    Save Shift
                </button>
                <p class="transparency-note text-[0.78rem] text-text-secondary leading-relaxed" id="transparencyNote" style="display: none;">
                    <!-- Populated dynamically by calculator.js -->
                </p>
            </div>

            <!-- Math Audit Log -->
            <div id="mathAuditLog" class="audit-log-section" style="display: none;">
                <div class="audit-log-header">
                    <span aria-hidden="true">🧮</span> Calculation Audit Log
                </div>
