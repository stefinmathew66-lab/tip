---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Server Error — TipSplit" description="Something went wrong on our end.">
    <main class="app-container flex flex-col items-center justify-center min-h-[70vh] text-center px-4">
        <div class="error-icon text-[5rem] mb-4 leading-none" aria-hidden="true">⚠️</div>
        <h1 class="text-[4rem] font-extrabold text-[#ef4444] leading-none mb-2">500</h1>
        <h2 class="text-xl font-bold text-text-primary mb-3">Something Went Wrong</h2>
        <p class="text-sm text-text-secondary max-w-sm leading-relaxed mb-8">
            An unexpected error occurred on our end. Don't worry — your data is safe in your browser. Please try refreshing the page.
        </p>
        <div class="flex gap-3 flex-wrap justify-center">
            <button onclick="location.reload()" class="inline-flex items-center gap-2 px-6 py-3 bg-accent-gradient border-none rounded-lg text-text-on-accent text-sm font-bold cursor-pointer transition-all duration-200 hover:-translate-y-0.5 hover:shadow-[0_6px_28px_rgba(240,165,0,0.35)] active:scale-[0.98]">
                <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
                    <path d="M3 9a6 6 0 0 1 10.47-4.03L15 3.5V8h-4.5l1.72-1.72A4 4 0 1 0 13 12.46" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                Refresh Page
            </button>
            <a href="/" class="inline-flex items-center gap-2 px-6 py-3 bg-transparent border-1.5 border-border rounded-lg text-text-primary text-sm font-bold no-underline transition-all duration-200 hover:border-accent hover:text-accent active:scale-[0.98]">
                <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
                    <path d="M14 9H4M4 9L8 5M4 9L8 13" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                Back to Calculator
            </a>
        </div>
        <footer class="mt-12 pt-5">
            <nav class="flex justify-center gap-4 text-[0.75rem] font-medium text-text-secondary" aria-label="Footer Navigation">
                <a href="/privacy" class="hover:text-accent transition-colors duration-150 no-underline">Privacy Policy</a>
                <span class="text-text-muted" aria-hidden="true">•</span>
                <a href="/terms" class="hover:text-accent transition-colors duration-150 no-underline">Terms</a>
                <span class="text-text-muted" aria-hidden="true">•</span>
                <a href="/contact" class="hover:text-accent transition-colors duration-150 no-underline">Contact Us</a>
            </nav>
        </footer>
    </main>
</Layout>
